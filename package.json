{
    "name": "tipstotreat",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build && tsc --noEmit",
        "preview": "vite preview",
        "deploy": "pnpm db:migrate:remote && vite build && tsc --noEmit && wrangler deploy",
        "cf-typegen": "wrangler types",
        "lint": "oxlint . --type-aware",
        "format": "oxfmt --write \"**/*.{ts,tsx}\"",
        "check": "oxlint . --type-aware && oxfmt --write \"**/*.{ts,tsx}\"",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate && node scripts/sync-migrations.mjs",
        "db:migrate:local": "wrangler d1 migrations apply DB --local",
        "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
        "db:seed:local": "node scripts/seed.mjs && wrangler d1 execute DB --local --file=.wrangler/seed.sql",
        "db:seed:remote": "node scripts/seed.mjs && wrangler d1 execute DB --remote --file=.wrangler/seed.sql"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@takumi-rs/helpers": "^2.13.4",
        "@takumi-rs/wasm": "^2.13.4",
        "@tanstack/ai": "^0.52.1",
        "@tanstack/ai-openai": "^0.22.3",
        "@tanstack/ai-react": "^0.23.0",
        "@tanstack/ai-utils": "^0.4.0",
        "@tanstack/openai-base": "^0.10.8",
        "@tanstack/react-devtools": "latest",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-form-devtools": "^0.2.34",
        "@tanstack/react-query": "^5.102.8",
        "@tanstack/react-query-devtools": "^5.102.8",
        "@tanstack/react-router": "latest",
        "@tanstack/react-router-devtools": "latest",
        "@tanstack/react-router-ssr-query": "latest",
        "@tanstack/react-start": "latest",
        "@tanstack/router-plugin": "latest",
        "@tiptap/extension-character-count": "^3.31.0",
        "@tiptap/extension-file-handler": "^3.31.0",
        "@tiptap/extension-image": "^3.31.0",
        "@tiptap/extension-link": "^3.31.0",
        "@tiptap/extension-placeholder": "^3.31.0",
        "@tiptap/extension-table": "^3.31.0",
        "@tiptap/extension-task-item": "^3.31.0",
        "@tiptap/extension-task-list": "^3.31.0",
        "@tiptap/markdown": "^3.31.0",
        "@tiptap/pm": "^3.31.0",
        "@tiptap/react": "^3.31.0",
        "@tiptap/starter-kit": "^3.31.0",
        "better-auth": "^1.7.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "drizzle-orm": "1.0.0-rc.4",
        "lucide-react": "^1.31.0",
        "openai": "^6.49.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "rehype-sanitize": "^6.0.0",
        "rehype-stringify": "^10.0.1",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "shadcn": "^4.18.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "unified": "^11.0.5",
        "zod": "^4.4.3"
    },
    "devDependencies": {
